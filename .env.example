# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # for secrets below

# Host user id for files written by Airflow into ./logs and ./data (macOS: `id -u`)
AIRFLOW_UID=50000

# Postgres superuser for the local stack (owns both the airflow and warehouse DBs)
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=
AIRFLOW_DB=airflow
WAREHOUSE_DB=warehouse
# Host port for the warehouse (container port 5432 is published on 127.0.0.1 only)
WAREHOUSE_HOST_PORT=5433

# Airflow 3 internal API signing secret (any long random string)
AIRFLOW_JWT_SECRET=
# Optional: encrypts Airflow connections/variables at rest
FERNET_KEY=

# --- RAG / evaluation ---------------------------------------------------------
# auto  -> Anthropic if ANTHROPIC_API_KEY is set, otherwise a local HF model
# anthropic | local
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
